          "$ref": "#/$defs/SearchPage"
        },
        "query": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/WebSearchResult"
          },
          "title": "Results",
          "type": "array"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/SearchWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "query",
        "warnings",
        "duration_ms",
        "results",
        "page"
      ],
      "title": "WebSearchResponse",
      "type": "object"
    },
    "WebSearchResult": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "web",
          "enum": [
            "web"
          ],
          "title": "Kind",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "snippet": {
          "default": "",
          "maxLength": 2000,
          "title": "Snippet",
          "type": "string"
        },
        "source_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "source_name",
        "kind"
      ],
      "title": "WebSearchResult",
      "type": "object"
    }
  },
  "$id": "https://nexus.local/schemas/search-contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEXUS Search & Discover Contracts"
}
